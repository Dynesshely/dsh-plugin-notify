{
  "name": "dsh-reminder",
  "version": "0.1.0",
  "description": "DSH web plugin: chime and desktop-notify when a session needs your answer, an approval, or finishes a turn.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check client/client.js",
    "test": "node test/reminder.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
